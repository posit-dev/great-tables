# name: test_as_latex[all]
  '''
  \begin{table}[!t]
  \caption*{
  {\large Parity} \\
  {\small as\_latex()}
  } 
  
  \fontsize{12.0pt}{14.4pt}\selectfont
  
  \begin{tabular*}{\linewidth}{@{\extracolsep{\fill}}l|rl}
  \toprule
    & \multicolumn{2}{c}{values} \\ 
  \cmidrule(lr){2-3}
    & x & s \\ 
  \midrule\addlinespace[2.5pt]
  \multicolumn{3}{l}{b} \\[2.5pt] 
  \midrule\addlinespace[2.5pt]
  apple & 1,234.57 & apple \\
  cherry & -0.25 & cherry \\
  \midrule\addlinespace[2.5pt]
  \multicolumn{3}{l}{a} \\[2.5pt] 
  \midrule\addlinespace[2.5pt]
  None & — & — \\
  \bottomrule
  \end{tabular*}
  
  \end{table}
  
  '''
