    'bool': list([
      'bool: True',
      'bool: False',
      'NoneType: None',
    ]),
    'categorical': list([
      'str: a',
      'str: b',
      'float: nan',
    ]),
    'categorical_ordered': list([
      'str: a',
      'str: b',
      'float: nan',
    ]),
    'date': list([
      'date: 2024-01-01',
      'date: 2024-02-29',
      'NoneType: None',
    ]),
    'datetime': list([
      'Timestamp: 2024-01-01 12:30:00',
      'Timestamp: 2024-02-29 00:00:00',
      'NaTType: NaT',
    ]),
    'datetime_tz': list([
      'Timestamp: 2024-01-01 12:30:00+00:00',
      'Timestamp: 2024-02-29 00:00:00+00:00',
      'NaTType: NaT',
    ]),
    'decimal': list([
      'Decimal: 1.50',
      'Decimal: -2.25',
      'NoneType: None',
    ]),
    'duration': list([
      'Timedelta: 0 days 01:00:00',
      'Timedelta: 2 days 00:00:00',
      'NaTType: NaT',
    ]),
    'float': list([
      'np.float64: 1.5',
      'np.float64: -0.0',
      'np.float64: nan',
    ]),
    'int': list([
      'np.float64: 1.0',
      'np.float64: 2.0',
      'np.float64: nan',
    ]),
    'list': list([
      'list: [1, 2]',
      'list: [3]',
      'NoneType: None',
    ]),
    'str': list([
      'str: a',
      'str: b',
      'None (pandas 2) or nan (pandas 3)',
    ]),
  })
