  dict({
    'bool': list([
      'bool: True',
      'bool: False',
      'NoneType: None',
    ]),
    'date': list([
      'date: 2024-01-01',
      'date: 2024-02-29',
      'NoneType: None',
    ]),
    'datetime': list([
      'datetime: 2024-01-01 12:30:00',
      'datetime: 2024-02-29 00:00:00',
      'NoneType: None',
    ]),
    'datetime_tz': list([
      'datetime: 2024-01-01 12:30:00+00:00',
      'datetime: 2024-02-29 00:00:00+00:00',
      'NoneType: None',
    ]),
    'decimal': list([
      'Decimal: 1.50',
      'Decimal: -2.25',
      'NoneType: None',
    ]),
    'duration': list([
      'timedelta: 1:00:00',
      'timedelta: 2 days, 0:00:00',
      'NoneType: None',
    ]),
    'float': list([
      'float: 1.5',
      'float: -0.0',
      'NoneType: None',
    ]),
    'int': list([
      'int: 1',
      'int: 2',
      'NoneType: None',
    ]),
    'list': list([
      'list: [1, 2]',
      'list: [3]',
      'NoneType: None',
    ]),
    'str': list([
      'str: a',
      'str: b',
      'NoneType: None',
    ]),
  })
# ---
# name: test_validate_frame_non_str_cols_warning
  '''
  pandas DataFrame contains non-string column names. Coercing to strings. Here are the first few non-string columns:
  
    * Position 1: 55
    * Position 3: 99
  '''
# ---
# name: test_values_handed_to_user_callables[pandas_constructor]
  dict({
    'data_color': dict({
      'datetime': list([
        'Timestamp: 2024-01-01 12:30:00',
        'NaTType: NaT',
      ]),
      'float': list([
        'float: 1.5',
        'float: nan',
      ]),
      'int': list([
        'float: 1.0',
        'float: nan',
      ]),
      'str': list([
        'str: a',
        'None (pandas 2) or nan (pandas 3)',
      ]),
    }),
    'fmt': dict({
      'datetime': list([
        'Timestamp: 2024-01-01 12:30:00',
        'NaTType: NaT',
      ]),
      'float': list([
        'np.float64: 1.5',
        'np.float64: nan',
      ]),
      'int': list([
        'np.float64: 1.0',
        'np.float64: nan',
      ]),
      'str': list([
        'str: a',
        'None (pandas 2) or nan (pandas 3)',
      ]),
    }),
    'text_transform': dict({
      'datetime': list([
        'str: 2024-01-01 12:30:00',
      ]),
      'float': list([
        'str: 1.5',
      ]),
      'int': list([
        'str: 1.0',
      ]),
      'str': list([
        'str: a',
      ]),
    }),
  })
